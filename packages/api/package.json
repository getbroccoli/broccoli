{
  "name": "@broccoli/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Broccoli API server.",
  "scripts": {
    "build": "tsdown",
    "codegen": "graphql-codegen",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@broccoli/config": "workspace:*",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-resolvers": "6.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@graphql-tools/schema": "10.1.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "graphql": "16.14.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  }
}
