# Optional. Copy this file to .env to override defaults. Docker Compose reads .env from this folder.

# Host port for Broccoli. `docker compose up` defaults to 8080 and `pnpm dev` to a free port; 0 picks a free port.
# HOST_WEB_PORT=8080

# API log level: fatal, error, warn, info, debug, trace or silent. Defaults to info.
# LOG_LEVEL=info

# Host port for the end-to-end test Postgres; leave unset to get a free port.
# HOST_PG_PORT=5433

# Address browsers use to reach Broccoli; only this origin may sign in. Unset trusts the address each request uses.
# Set an https URL to get Secure session cookies.
# PUBLIC_URL=https://broccoli.example.com

# self_hosted (the default): the first visitor creates the owner account. managed: the owner signs in through the managed service.
# BROCCOLI_MODE=self_hosted
